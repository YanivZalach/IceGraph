{
  "name": "icegraph-frontend",
  "private": true,
  "author": "Yaniv Zalach",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "copy-skill": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync('../claude-plugin/skills/icegraph/SKILL.md','public/SKILL.md')\"",
    "predev": "npm run copy-skill",
    "dev": "vite",
    "prebuild": "npm run copy-skill",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "msw:init": "msw init public/"
  },
  "dependencies": {
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-table": "^9.2.3",
    "clsx": "^2.1.1",
    "json-bigint": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.168.29",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "msw": "^2.7.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
